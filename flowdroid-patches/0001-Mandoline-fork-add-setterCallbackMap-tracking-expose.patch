 pom.xml                                            |  2 +-
 soot-infoflow-android/pom.xml                      |  4 ++--
 .../jimple/infoflow/android/SetupApplication.java  | 12 ++++++++++++
 .../callbacks/AbstractCallbackAnalyzer.java        | 14 ++++++++++++--
 soot-infoflow-cmd/pom.xml                          |  6 +++---
 soot-infoflow-summaries/pom.xml                    |  6 +++---
 soot-infoflow/pom.xml                              |  2 +-
 7 files changed, 34 insertions(+), 12 deletions(-)

